# Copy to a non-committed .env file and set real values locally. Never commit real keys.

# --- LLM (Team B) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# --- Evidence retrieval: SearXNG (self-hosted, JSON format must be enabled in its settings.yml) ---
SEARXNG_BASE_URL=http://127.0.0.1:8888
SEARXNG_CATEGORIES=general,news
SEARXNG_TIMEOUT_SECONDS=10
SEARXNG_RESULTS_PER_QUERY=20
SEARXNG_MAX_PAGES=1
SEARXNG_MAX_QUERIES=2

# --- FAISS cache of extracted evidence chunks (starts empty; no dataset) ---
FAISS_INDEX_PATH=indexes/truthlens.faiss
FAISS_METADATA_PATH=indexes/metadata.pkl
FAISS_SIMILARITY_THRESHOLD=0.75
FAISS_CACHE_TTL_DAYS=7
FAISS_MIN_RECENCY_SCORE=0.60

# --- Exact normalized-claim verdict cache ---
VERDICT_CACHE_PATH=indexes/verdict_cache.sqlite3
VERDICT_CACHE_TTL_DAYS=7

# --- Selection ---
SEARCH_TOP_N=10
EVIDENCE_TOP_K=5

# --- Fetching (robots.txt is always honoured) ---
CRAWLER_USER_AGENT=TruthLensBot/1.0 (+https://github.com/adityardy05/TruthLensAI)
FETCH_TIMEOUT_SECONDS=8
FETCH_TOTAL_BUDGET_SECONDS=25
HOST_MIN_DELAY_SECONDS=1.0

# --- Chunking ---
CHUNK_CHARS=600
CHUNK_OVERLAP_CHARS=80
MAX_CHUNKS_PER_ARTICLE=25
MAX_CHUNKS_PER_CLAIM=150

# --- R(d) weights: relevance / quality / credibility / recency ---
WEIGHT_RELEVANCE=0.40
WEIGHT_QUALITY=0.20
WEIGHT_CREDIBILITY=0.25
WEIGHT_RECENCY=0.15
UNDATED_RECENCY_SCORE=0.40

# --- App ---
TRUTHLENS_BACKEND_URL=http://127.0.0.1:5000
TELEGRAM_BOT_TOKEN=
MAX_UPLOAD_BYTES=5242880

